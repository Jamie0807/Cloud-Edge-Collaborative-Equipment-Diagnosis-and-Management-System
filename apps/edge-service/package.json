{
  "name": "@diagnostics/edge-service",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "lint": "python3 -m ruff check src tests",
    "format:check": "python3 -m ruff format --check src tests",
    "typecheck": "python3 -m mypy src",
    "test": "python3 -m pytest",
    "build": "PYTHONPYCACHEPREFIX=${TMPDIR:-/tmp}/diagnostics-pycache python3 -m compileall -q src"
  }
}
